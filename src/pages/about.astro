---
import { getEntry } from "astro:content";
import DefaultLayout from "../layouts/DefaultLayout.astro";
import LinkCard from "../components/LinkCard.vue";
import HoveredTechName from "../components/HoveredTechName.vue";

const aboutContent = await getEntry("pages", "about");
const { bio, stack } = aboutContent?.data;
---

<DefaultLayout title="About - Luke Climenhage">
  <main class="relative z-10 max-w-3xl mx-auto px-6 py-12">
    <!-- Bio Section -->
    <section class="mb-6">
      <h2 class="font-display text-sm font-light tracking-widest text-white uppercase mb-8">Background</h2>
      <div class="space-y-4">
        {
          bio?.map((paragraph: string) => (
            <p class="text-purple-100/75 leading-relaxed">{paragraph}</p>
          ))
        }
      </div>
    </section>

    <div class="relative h-px w-full mb-6 bg-gradient-to-r from-transparent via-purple-200/50 to-transparent shadow-lg shadow-purple-300/40"></div>

    <!-- Stack Section -->
    <section class="mb-12">
      <div class="flex items-center justify-between mb-6 h-14">
        <h2 class="font-display text-sm font-light tracking-widest text-white uppercase">Stack</h2>
        <HoveredTechName client:load />
      </div>
      <div class="space-y-8">
        {
          stack?.map(
            (group: {
              category: string;
              technologies: {
                name: string;
                url?: string;
                image?: string;
                startYear?: number;
                endYear?: number | "present";
              }[];
            }) => (
              <div>
                <h3 class="font-display text-xs font-medium text-purple-300 uppercase tracking-widest mb-3">
                  {group.category}
                </h3>
                <div class="flex flex-wrap gap-2">
                  {group.technologies.map(
                    (tech: {
                      name: string;
                      url?: string;
                      image?: string;
                      startYear?: number;
                      endYear?: number | "present";
                    }) => (
                      <LinkCard
                        client:load
                        name={tech.name}
                        url={tech.url}
                        image={tech.image}
                        startYear={tech.startYear}
                        endYear={tech.endYear}
                      />
                    ),
                  )}
                </div>
              </div>
            ),
          )
        }
      </div>
    </section>
  </main>
</DefaultLayout>
